{
  "id": "pf2e-automatic-item-resolution",
  "title": "PF2e Automatic Item Resolution",
  "description": "Automates PF2e's items in live play and, through the resolution core, in the Combat Simulator: consumables (potions, elixirs, mutagens, poisons, bombs, talismans, oils, snares) and activated permanent items, each with a confirmation card.",
  "version": "0.24.0",
  "url": "https://github.com/Theholycole/pf2e-automatic-item-resolution",
  "manifest": "https://github.com/Theholycole/pf2e-automatic-item-resolution/releases/latest/download/module.json",
  "download": "https://github.com/Theholycole/pf2e-automatic-item-resolution/releases/download/v0.23.0/module.zip",
  "readme": "https://github.com/Theholycole/pf2e-automatic-item-resolution#readme",
  "bugs": "https://github.com/Theholycole/pf2e-automatic-item-resolution/issues",
  "license": "LICENSE",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "TheHolyCole"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "8.5.0",
          "verified": "8.6.1"
        }
      }
    ],
    "requires": [
      {
        "id": "pf2e-resolution-core",
        "type": "module",
        "reason": "Items are resolved by the core's families.",
        "manifest": "https://github.com/Theholycole/PF2e-Automation-Core/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "0.7.8"
        }
      },
      {
        "id": "pf2e-automatic-ability-resolution",
        "type": "module",
        "reason": "An item's saves, afflictions and effects are read by the ability module's compiler.",
        "manifest": "https://github.com/Theholycole/pf2e-automatic-ability-resolution/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "0.9.5"
        }
      }
    ],
    "recommends": [
      {
        "id": "pf2e-automatic-resolution",
        "type": "module",
        "manifest": "https://github.com/Theholycole/pf2e-automatic-spell-resolution/releases/latest/download/module.json",
        "reason": "It casts the spells items cast (its castFromItem), and the items it acts on itself are left to it.",
        "compatibility": {
          "minimum": "0.11.0"
        }
      },
      {
        "id": "pf2e-automatic-environment-resolution",
        "type": "module",
        "manifest": "https://github.com/Theholycole/pf2e-automatic-environment-resolution/releases/latest/download/module.json",
        "reason": "It applies what items do about its weather and falls: protection from heat and cold, falls made shorter or harmless, and fog, rain or wind ignored.",
        "compatibility": {
          "minimum": "0.2.2"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/item.css"
  ],
  "socket": true,
  "packs": [
    {
      "name": "items",
      "label": "PF2e Automatic Item Resolution",
      "path": "packs/items",
      "type": "Item",
      "system": "pf2e",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "flags": {}
    }
  ]
}
